{
  "name": "telegram-archive-viewer",
  "private": true,
  "version": "3.7.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "sync-version": "node scripts/sync-version.js && node scripts/prepare-assets.js",
    "build": "node scripts/sync-version.js && node scripts/prepare-assets.js && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"vite --port=3000 --host=0.0.0.0\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "node scripts/sync-version.js && node scripts/prepare-assets.js && vite build && electron-builder --win",
    "electron:pack": "node scripts/sync-version.js && node scripts/prepare-assets.js && vite build && electron-builder --dir",
    "release": "npm run electron:build"
  },
  "author": "Jared Lee",
  "build": {
    "appId": "com.telegram.archiveviewer",
    "productName": "Telegram Archive Viewer",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telegram Archive Viewer",
      "uninstallDisplayName": "Telegram Archive Viewer ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "multiLanguageInstaller": false
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/pako": "^3.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "idb-keyval": "^6.3.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.546.0",
    "pako": "^3.0.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  }
}
